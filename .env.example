# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-vm-ip

# Optional: superuser created on backend start (skipped if email or password is empty)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# PostgreSQL (used by the db container and the backend)
POSTGRES_DB=conduit
POSTGRES_USER=conduit
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Published host port of the frontend (default 8282)
CONDUIT_PORT=8282

# Image tag pulled from GHCR (commit SHA or latest, default latest)
IMAGE_TAG=latest
